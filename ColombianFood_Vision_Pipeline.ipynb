    "## 6. Enfoque 2: Redes Neuronales Profundas (PyTorch Transfer Learning - MobileNetV3)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "print(f\"Ejecutando en dispositivo: {device}\")\n",
    "\n",
    "cnn_transform = transforms.Compose([\n",
    "    transforms.Resize((224, 224)),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225])\n",
    "])\n",
    "\n",
    "dataset_test = datasets.ImageFolder(PROCESSED_DIR / \"test\", cnn_transform)\n",
    "test_loader = DataLoader(dataset_test, batch_size=16, shuffle=False)\n",
    "\n",
    "# Cargar modelo si ya fue entrenado\n",
    "checkpoint_path = Path(\"models/best_cnn_model.pth\")\n",
    "if checkpoint_path.exists():\n",
    "    checkpoint = torch.load(checkpoint_path, map_location=device)\n",
    "    model_cnn = models.mobilenet_v3_small()\n",
    "    model_cnn.classifier[3] = nn.Linear(model_cnn.classifier[3].in_features, len(categories))\n",
    "    model_cnn.load_state_dict(checkpoint['state_dict'])\n",
    "    model_cnn.to(device)\n",
    "    model_cnn.eval()\n",
    "    print(f\"✅ Modelo CNN cargado exitosamente desde {checkpoint_path} (Precisión en Val: {checkpoint['val_acc']*100:.2f}%)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Matriz de Confusión y Ejemplo de Inferencia"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": None,
   "metadata": {},
   "outputs": [],
   "source": [
    "all_preds = []\n",
    "all_targets = []\n",
    "\n",
    "with torch.no_grad():\n",
    "    for inputs, labels in test_loader:\n",
    "        inputs = inputs.to(device)\n",
    "        outputs = model_cnn(inputs)\n",
    "        _, preds = torch.max(outputs, 1)\n",
    "        all_preds.extend(preds.cpu().numpy())\n",
    "        all_targets.extend(labels.numpy())\n",
    "\n",
    "cm = confusion_matrix(all_targets, all_preds)\n",
    "\n",
    "plt.figure(figsize=(12, 10))\n",
    "sns.heatmap(cm, annot=True, fmt='d', cmap='YlGnBu', xticklabels=categories, yticklabels=categories)\n",
    "plt.title(\"Matriz de Confusión - Red Neuronal MobileNetV3 (Test Set)\", fontsize=14, fontweight='bold')\n",
    "plt.xlabel(\"Predicción\", fontsize=12)\n",
    "plt.ylabel(\"Clase Real\", fontsize=12)\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
